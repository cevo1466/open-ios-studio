{
  "name": "open-ios-studio",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:dependencies": "node --test scripts/audit-dependencies-check.mjs && node scripts/audit-dependencies.mjs",
    "tauri": "tauri",
    "e2e": "playwright test",
    "validate:policies": "node scripts/validate-policies.mjs && node scripts/policy-gate.mjs --self-test",
    "doctor": "bash scripts/doctor.sh",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run validate:policies",
    "test:simulator": "cargo test --locked --manifest-path tools/simulator-harness/Cargo.toml",
    "e2e:simulator": "playwright test e2e/simulator.spec.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "engines": {
    "node": ">=22"
  }
}
